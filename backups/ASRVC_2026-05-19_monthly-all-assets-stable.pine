        ratio7 := eth_15m_ratio7    // ETH 15分钟蓝色上轨
        ratio8 := eth_15m_ratio8    // ETH 15分钟蓝色中轨
        ratio9 := eth_15m_ratio9    // ETH 15分钟蓝色下轨
        ratio10 := eth_15m_ratio10  // ETH 15分钟超卖线
    else
        // BTC通用参数 - 15分钟精确比例系数（基于原作者指标值计算）
        // 中轨基准值: 103169.1
        ratio0 := 1.0363  // 超买线: 106914.4/103169.1
        ratio1 := 1.0230  // 橙色上轨: 105545.1/103169.1
        ratio2 := 1.0181  // 橙色中轨: 105041.8/103169.1
        ratio3 := 1.0135  // 橙色下轨: 104566.3/103169.1
        ratio4 := 1.0091  // 中间上轨: 104104.5/103169.1
        ratio5 := 1.0000  // 中间基准: 103169.1/103169.1
        ratio6 := 0.9910  // 中间下轨: 102232.8/103169.1
        ratio7 := 0.9868  // 蓝色上轨: 101802.8/103169.1
        ratio8 := 0.9819  // 蓝色中轨: 101296.5/103169.1
        ratio9 := 0.9764  // 蓝色下轨: 100737.6/103169.1
        ratio10 := 0.9636 // 超卖线: 99423.9/103169.1
else if (timeframe_minutes == 5)
    // 5分钟精确比例 - 基于原作者提供的准确数值
