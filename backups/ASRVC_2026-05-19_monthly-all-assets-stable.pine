else
    ratio0 := 1.047
    ratio1 := 1.030
    ratio2 := 1.024
    ratio3 := 1.017
    ratio4 := 1.012
    ratio5 := 1.000
    ratio6 := 0.988
    ratio7 := 0.983
    ratio8 := 0.976
    ratio9 := 0.971
    ratio10 := 0.953

// 计算通道线 - 4小时以上和1小时需要特殊处理
useRawRatio = (timeframe_minutes >= 240 and not isMonthlyTf) or timeframe_minutes == 60 or timeframe_minutes == 1440

// 日线通道的倍率 - 修正中间通道宽度过大的问题
daily_multiplier = timeframe_minutes == 1440 ? 1.5 : 1.0

// 初始化所有通道变量，确保它们在所有条件分支中都有定义
overbought = 0.0
orangeUpper = 0.0
orangeMid = 0.0
orangeLower = 0.0
midUpper = 0.0
midMid = 0.0
midLower = 0.0
blueUpper = 0.0
blueMid = 0.0
blueLower = 0.0
oversold = 0.0

// 日线级别特殊处理 - 使用自主研发的参数化方法
if (timeframe_minutes == 1440 and not useEthKernel)
    // 计算中轨 - 使用带调整的SMA
    float base_mid = ta.sma(close, sma_length) * mid_adjust
    float atr_val = ta.atr(atr_length)
    
    // 计算通道上下范围 - 基于精确计算的倍数
    // 分析显示通道宽度大约是中轨价值的50.7%
    float upper_band = upper_mult * base_mid
    float lower_band = lower_mult * base_mid
    
    // 使用分布系数计算各通道线
    midMid := base_mid
    
    // 上部通道 - 通过逆向工程得出的比例系数计算
    overbought := base_mid + upper_band * ou_ratio    // 135688.87
    orangeUpper := base_mid + upper_band * o1_ratio   // 120078.3
    orangeMid := base_mid + upper_band * o2_ratio     // 112877.67
    orangeLower := base_mid + upper_band * o3_ratio   // 106091.63
    midUpper := base_mid + upper_band * o4_ratio      // 101472.12
    
    // 下部通道 - 通过逆向工程得出的比例系数计算
    midLower := base_mid - lower_band * o6_ratio      // 78661.02
    blueUpper := base_mid - lower_band * o7_ratio     // 74360.69
    blueMid := base_mid - lower_band * o8_ratio       // 67255.47
    blueLower := base_mid - lower_band * o9_ratio     // 60374.02
    oversold := base_mid - lower_band * ol_ratio      // 44444.27
else
    // 非日线级别使用原来的计算方法
    overbought := useRawRatio ? midLine * ratio0 : ta.wma(midLine * ratio0, smoothing)
    orangeUpper := useRawRatio ? midLine * ratio1 : ta.wma(midLine * ratio1, smoothing)

    // 特殊处理1小时级别的橙色中轨和下轨，确保层级正确
    if (timeframe_minutes == 60)
        // 原始比例中，橙色中轨的比例(0.9845)小于下轨比例(0.9883)
        // 这会导致中轨显示在下轨下方，违反了通道的层级逻辑
        
        // 用比例计算原始值
        orangeMid_value = midLine * ratio2
        orangeLow_value = midLine * ratio3
        
        // 特殊处理：强制中轨比下轨高出0.2%，保持视觉上的正确层级
        if (ratio2 < ratio3)
            orangeMid := orangeLow_value * 1.002
            orangeLower := orangeLow_value
        else
            orangeMid := useRawRatio ? midLine * ratio2 : ta.wma(midLine * ratio2, smoothing)
            orangeLower := useRawRatio ? midLine * ratio3 : ta.wma(midLine * ratio3, smoothing)
    else
        orangeMid := useRawRatio ? midLine * ratio2 : ta.wma(midLine * ratio2, smoothing)
        orangeLower := useRawRatio ? midLine * ratio3 : ta.wma(midLine * ratio3, smoothing)

    midUpper := useRawRatio ? midLine * ratio4 : ta.wma(midLine * ratio4, smoothing)
    midMid := useRawRatio ? midLine * ratio5 : ta.wma(midLine * ratio5, smoothing)
    midLower := useRawRatio ? midLine * ratio6 : ta.wma(midLine * ratio6, smoothing)
    blueUpper := useRawRatio ? midLine * ratio7 : ta.wma(midLine * ratio7, smoothing)

    // 同样特殊处理蓝色中轨和上轨，确保层级正确
    if (timeframe_minutes == 60 and ratio8 > ratio7)
        // 如果蓝色中轨比例(0.9312)大于上轨比例(0.9324)，
        // 强制中轨比上轨低0.2%，保持视觉上的正确层级
        blueMid := blueUpper * 0.998
    else
        blueMid := useRawRatio ? midLine * ratio8 : ta.wma(midLine * ratio8, smoothing)

    blueLower := useRawRatio ? midLine * ratio9 : ta.wma(midLine * ratio9, smoothing)
    oversold := useRawRatio ? midLine * ratio10 : ta.wma(midLine * ratio10, smoothing)
    
    // 特殊处理ETH 30分钟时间周期 - 为所有通道线添加30点调整
    if (timeframe_minutes == 30 and useEthKernel)
        overbought := overbought + eth_30m_base_adjust
        orangeUpper := orangeUpper + eth_30m_base_adjust
        orangeMid := orangeMid + eth_30m_base_adjust
        orangeLower := orangeLower + eth_30m_base_adjust
        midUpper := midUpper + eth_30m_base_adjust
        midMid := midMid + eth_30m_base_adjust
        midLower := midLower + eth_30m_base_adjust
        blueUpper := blueUpper + eth_30m_base_adjust
        blueMid := blueMid + eth_30m_base_adjust
        blueLower := blueLower + eth_30m_base_adjust
        oversold := oversold + eth_30m_base_adjust
    
    // 特殊处理ETH 45分钟时间周期 - 为所有通道线添加微调
    if (timeframe_minutes == 45 and useEthKernel)
        overbought := overbought + eth_45m_base_adjust
        orangeUpper := orangeUpper + eth_45m_base_adjust
        orangeMid := orangeMid + eth_45m_base_adjust
        orangeLower := orangeLower + eth_45m_base_adjust
        midUpper := midUpper + eth_45m_base_adjust
        midMid := midMid + eth_45m_base_adjust
        midLower := midLower + eth_45m_base_adjust
        blueUpper := blueUpper + eth_45m_base_adjust
        blueMid := blueMid + eth_45m_base_adjust
